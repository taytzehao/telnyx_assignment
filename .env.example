# ── Environment Variables ──────────────────────────────────
# Copy to .env and fill in. .env is gitignored (see .gitignore).

# Telnyx API key — required for:
#   - workflow/client.ts (TelnyxAssistantClient) to create/update/retrieve
#     AI Assistants via the Telnyx SDK
#   - edge function Telnyx API calls via the MY_TELNYX binding
# Get yours at https://portal.telnyx.com/#/auth/users/api-keys
TELNYX_API_KEY=

# ── Edge Function Bindings (edge/telnyx.toml) ──────────────
# Not env vars, but must be configured before `npm run deploy`:
#
#   [storage.kv.SESSIONS]
#   id = "<KV_NAMESPACE_UUID>"   — create via telnyx-edge or the Portal
#
#   [edge_compute]
#   func_id = "<FUNC_ID>"        — bootstrapped automatically by deploy.ts
#                                  on first run if empty

# ── Assistant Deployment ──────────────────────────────────
# Set ASSISTANT_ID after the first `npm run deploy` so redeploys
# update the existing assistant instead of creating duplicates.
# Leave empty on the first run; the script prints the new ID and
# tells you to paste it here.
ASSISTANT_ID=

# Base URL of the deployed edge function (without /webhook suffix).
# Used by `npm run deploy:assistant` when --webhook-url is not passed.
# `npm run deploy` fetches the URL automatically from the function,
# so this is only needed for standalone assistant deploys.
ASSISTANT_CACHE=
