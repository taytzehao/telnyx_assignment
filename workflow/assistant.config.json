{
  "name": "ACME Clinic Assistant",
  "instructions": [
    "@prompt:clinic_role",
    "@prompt:appt_slot_context",
    "@prompt:human_line",
    "@prompt:caller_context",
    "@prompt:controller_contract"
  ],
  "model": "zai-org/GLM-5.2",
  "dynamic_variables_webhook_url": "",
  "dynamic_variables_webhook_timeout_ms": 5000,
  "enabled_features": [
    "telephony"
  ],
  "mcp_servers": [],
  "dynamic_variables": {
    "caller_number": "unknown",
    "call_count": 0,
    "is_returning_caller": false,
    "last_intent": "",
    "greeting": "Hello! Thanks for calling.",
    "escalation_enabled": false,
    "appointment_date": "",
    "appointment_start_time": "",
    "cancel_date": "",
    "cancel_start_time": "",
    "cancel_appointment_id": "",
    "caller_appointments": "[]"
  },
  "conversation_flow": {
    "start_node_id": "n_greeting",
    "nodes": [
      {
        "type": "speak",
        "id": "n_greeting",
        "name": "Greeting",
        "message": "{{greeting}} Welcome to ACME Clinic. How can I help you today?"
      },
      {
        "id": "n_intent",
        "name": "Identify Intent",
        "instructions": ["@prompt:n_intent"],
        "instructions_mode": "append",
        "shared_tool_ids": [],
        "tools_mode": "replace"
      },
      {
        "id": "n_faq",
        "name": "Answer FAQ",
        "instructions": ["@prompt:n_faq"],
        "instructions_mode": "append",
        "tools_mode": "append"
      },
      {
        "id": "n_appt_menu",
        "name": "Appointment Menu",
        "instructions": ["@prompt:n_appt_menu"],
        "instructions_mode": "append",
        "shared_tool_ids": [],
        "tools_mode": "replace"
      },
      {
        "id": "n_collect_appt",
        "name": "Collect Appt Details",
        "instructions": ["@prompt:n_collect_appt"],
        "instructions_mode": "append",
        "shared_tool_ids": [
          "PLACEHOLDER_CAPTURE_TOOL_ID"
        ],
        "tools_mode": "replace"
      },
      {
        "id": "n_verify_create",
        "name": "Verify Create",
        "instructions": ["@prompt:verify_contract", "@prompt:n_verify_create"],
        "instructions_mode": "append",
        "shared_tool_ids": [],
        "tools_mode": "replace"
      },
      {
        "id": "n_create_appt",
        "name": "Create Appointment",
        "instructions": ["@prompt:n_create_appt"],
        "instructions_mode": "append",
        "shared_tool_ids": [
          "PLACEHOLDER_CREATE_TOOL_ID"
        ],
        "tools_mode": "replace"
      },
      {
        "id": "n_confirm_book",
        "name": "Confirm Booking",
        "instructions": ["@prompt:n_confirm_book"],
        "instructions_mode": "append"
      },
      {
        "id": "n_suggest_alt",
        "name": "Suggest Alternatives",
        "instructions": ["@prompt:n_suggest_alt"],
        "instructions_mode": "append",
        "shared_tool_ids": [
          "PLACEHOLDER_CAPTURE_TOOL_ID"
        ],
        "tools_mode": "replace"
      },
      {
        "id": "n_list_appt",
        "name": "List Appointments",
        "instructions": ["@prompt:n_list_appt"],
        "instructions_mode": "append",
        "shared_tool_ids": [
          "PLACEHOLDER_LIST_TOOL_ID"
        ],
        "tools_mode": "replace"
      },
      {
        "id": "n_show_appt",
        "name": "Show Appointments",
        "instructions": ["@prompt:n_show_appt"],
        "instructions_mode": "append"
      },
      {
        "id": "n_collect_cancel",
        "name": "Collect Cancel Details",
        "instructions": ["@prompt:n_collect_cancel"],
        "instructions_mode": "append",
        "shared_tool_ids": [
          "PLACEHOLDER_CAPTURE_TOOL_ID"
        ],
        "tools_mode": "replace"
      },
      {
        "id": "n_verify_cancel",
        "name": "Verify Cancel",
        "instructions": ["@prompt:verify_contract", "@prompt:n_verify_cancel"],
        "instructions_mode": "append",
        "shared_tool_ids": [],
        "tools_mode": "replace"
      },
      {
        "id": "n_cancel_appt",
        "name": "Cancel Appointments",
        "instructions": ["@prompt:n_cancel_appt"],
        "instructions_mode": "append",
        "shared_tool_ids": [
          "PLACEHOLDER_CANCEL_TOOL_ID"
        ],
        "tools_mode": "replace"
      },
      {
        "id": "n_confirm_cancel",
        "name": "Confirm Cancellation",
        "instructions": ["@prompt:n_confirm_cancel"],
        "instructions_mode": "append"
      },
      {
        "id": "n_escalate",
        "name": "Escalate",
        "instructions": ["@prompt:n_escalate"],
        "instructions_mode": "append"
      },
      {
        "id": "n_anything_else",
        "name": "Anything Else?",
        "instructions": ["@prompt:n_anything_else"],
        "instructions_mode": "append",
        "shared_tool_ids": [],
        "tools_mode": "replace"
      },
      {
        "type": "speak",
        "id": "n_goodbye",
        "name": "Goodbye",
        "message": "Thank you for calling ACME Clinic. We appreciate your call and look forward to serving you. Have a wonderful day. Goodbye."
      },
      {
        "type": "tool",
        "id": "n_hangup",
        "name": "Hangup",
        "shared_tool_id": "tool-c197145f-507c-4aae-81af-e27119417232"
      }
    ],
    "edges": [
      {
        "id": "e_greeting_to_intent",
        "start_node_id": "n_greeting",
        "target": {
          "type": "node",
          "node_id": "n_intent"
        },
        "condition": {
          "type": "default"
        }
      },
      {
        "id": "e_intent_to_faq",
        "start_node_id": "n_intent",
        "target": {
          "type": "node",
          "node_id": "n_faq"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller asks about office hours, location, services, or fees."
        }
      },
      {
        "id": "e_intent_to_appt_menu",
        "start_node_id": "n_intent",
        "target": {
          "type": "node",
          "node_id": "n_appt_menu"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller wants to book, view, or cancel an appointment."
        }
      },
      {
        "id": "e_intent_to_escalate",
        "start_node_id": "n_intent",
        "target": {
          "type": "node",
          "node_id": "n_escalate"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller request is outside FAQ and appointment management, or they explicitly ask for a human."
        }
      },
      {
        "id": "e_intent_to_goodbye",
        "start_node_id": "n_intent",
        "target": {
          "type": "node",
          "node_id": "n_goodbye"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller says they do not need any help."
        }
      },
      {
        "id": "e_intent_timeout_to_goodbye",
        "start_node_id": "n_intent",
        "target": {
          "type": "node",
          "node_id": "n_goodbye"
        },
        "condition": {
          "type": "expression",
          "expression": {
            "type": "comparison",
            "op": ">=",
            "left": {
              "type": "variable",
              "name": "telnyx_conversation_duration_secs"
            },
            "right": {
              "type": "number_literal",
              "value": 600
            }
          }
        }
      },
      {
        "id": "e_faq_to_escalate",
        "start_node_id": "n_faq",
        "target": {
          "type": "node",
          "node_id": "n_escalate"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller question is not about hours, location, services, or fees, and cannot be answered by this bot."
        }
      },
      {
        "id": "e_faq_to_anything_else",
        "start_node_id": "n_faq",
        "target": {
          "type": "node",
          "node_id": "n_anything_else"
        },
        "condition": {
          "type": "llm",
          "prompt": "The FAQ question has been answered and the caller has no more questions."
        }
      },
      {
        "id": "e_appt_menu_to_collect",
        "start_node_id": "n_appt_menu",
        "target": {
          "type": "node",
          "node_id": "n_collect_appt"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller wants to create a new appointment."
        }
      },
      {
        "id": "e_appt_menu_to_list",
        "start_node_id": "n_appt_menu",
        "target": {
          "type": "node",
          "node_id": "n_list_appt"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller wants to see their existing appointments."
        }
      },
      {
        "id": "e_appt_menu_to_cancel",
        "start_node_id": "n_appt_menu",
        "target": {
          "type": "node",
          "node_id": "n_collect_cancel"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller wants to cancel an appointment."
        }
      },
      {
        "id": "e_appt_menu_to_anything_else",
        "start_node_id": "n_appt_menu",
        "target": {
          "type": "node",
          "node_id": "n_anything_else"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller changed their mind and does not want appointment management."
        }
      },
      {
        "id": "e_collect_to_verify_create",
        "start_node_id": "n_collect_appt",
        "target": {
          "type": "node",
          "node_id": "n_verify_create"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller has provided a date and a 30-minute timeslot."
        }
      },
      {
        "id": "e_verify_create_to_create",
        "start_node_id": "n_verify_create",
        "target": {
          "type": "node",
          "node_id": "n_create_appt"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller explicitly confirms the appointment details with an unqualified yes."
        }
      },
      {
        "id": "e_verify_create_back_to_collect",
        "start_node_id": "n_verify_create",
        "target": {
          "type": "node",
          "node_id": "n_collect_appt"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller wants to change the date or time of the appointment."
        }
      },
      {
        "id": "e_verify_create_to_anything_else",
        "start_node_id": "n_verify_create",
        "target": {
          "type": "node",
          "node_id": "n_anything_else"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller no longer wants to book an appointment and wants to do something else."
        }
      },
      {
        "id": "e_create_to_confirm_book",
        "start_node_id": "n_create_appt",
        "target": {
          "type": "node",
          "node_id": "n_confirm_book"
        },
        "condition": {
          "type": "llm",
          "prompt": "The create_appointment tool returned a successful result and the appointment was created."
        }
      },
      {
        "id": "e_create_to_suggest_alt",
        "start_node_id": "n_create_appt",
        "target": {
          "type": "node",
          "node_id": "n_suggest_alt"
        },
        "condition": {
          "type": "llm",
          "prompt": "The create_appointment tool returned a conflict with suggested alternative times."
        }
      },
      {
        "id": "e_list_to_show",
        "start_node_id": "n_list_appt",
        "target": {
          "type": "node",
          "node_id": "n_show_appt"
        },
        "condition": {
          "type": "llm",
          "prompt": "The list_appointments tool returned the caller's appointment list."
        }
      },
      {
        "id": "e_show_to_anything_else",
        "start_node_id": "n_show_appt",
        "target": {
          "type": "node",
          "node_id": "n_anything_else"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller has reviewed their appointments and is done."
        }
      },
      {
        "id": "e_collect_cancel_to_verify",
        "start_node_id": "n_collect_cancel",
        "target": {
          "type": "node",
          "node_id": "n_verify_cancel"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller has specified which appointment to cancel by time or ID."
        }
      },
      {
        "id": "e_verify_cancel_to_cancel",
        "start_node_id": "n_verify_cancel",
        "target": {
          "type": "node",
          "node_id": "n_cancel_appt"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller explicitly confirms the cancellation with an unqualified yes."
        }
      },
      {
        "id": "e_verify_cancel_back_to_collect",
        "start_node_id": "n_verify_cancel",
        "target": {
          "type": "node",
          "node_id": "n_collect_cancel"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller wants to cancel a different appointment instead."
        }
      },
      {
        "id": "e_verify_cancel_to_anything_else",
        "start_node_id": "n_verify_cancel",
        "target": {
          "type": "node",
          "node_id": "n_anything_else"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller no longer wants to cancel and wants to do something else."
        }
      },
      {
        "id": "e_cancel_to_confirm_cancel",
        "start_node_id": "n_cancel_appt",
        "target": {
          "type": "node",
          "node_id": "n_confirm_cancel"
        },
        "condition": {
          "type": "llm",
          "prompt": "The cancel_appointments tool succeeded and the appointment was cancelled."
        }
      },
      {
        "id": "e_cancel_back_to_collect",
        "start_node_id": "n_cancel_appt",
        "target": {
          "type": "node",
          "node_id": "n_collect_cancel"
        },
        "condition": {
          "type": "llm",
          "prompt": "The cancel_appointments tool returned that no matching appointment was found."
        }
      },
      {
        "id": "e_suggest_alt_to_verify_create",
        "start_node_id": "n_suggest_alt",
        "target": {
          "type": "node",
          "node_id": "n_verify_create"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller picks one of the suggested alternative slots."
        }
      },
      {
        "id": "e_suggest_alt_back_to_collect",
        "start_node_id": "n_suggest_alt",
        "target": {
          "type": "node",
          "node_id": "n_collect_appt"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller wants to try a completely different time."
        }
      },
      {
        "id": "e_suggest_alt_to_anything_else",
        "start_node_id": "n_suggest_alt",
        "target": {
          "type": "node",
          "node_id": "n_anything_else"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller wants to do something else instead of booking."
        }
      },
      {
        "id": "e_confirm_book_to_anything_else",
        "start_node_id": "n_confirm_book",
        "target": {
          "type": "node",
          "node_id": "n_anything_else"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller acknowledges the booking."
        }
      },
      {
        "id": "e_confirm_cancel_to_anything_else",
        "start_node_id": "n_confirm_cancel",
        "target": {
          "type": "node",
          "node_id": "n_anything_else"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller acknowledges the cancellation."
        }
      },
      {
        "id": "e_escalate_to_goodbye",
        "start_node_id": "n_escalate",
        "target": {
          "type": "node",
          "node_id": "n_goodbye"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller acknowledges the escalation message."
        }
      },
      {
        "id": "e_anything_else_to_intent",
        "start_node_id": "n_anything_else",
        "target": {
          "type": "node",
          "node_id": "n_intent"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller says they need additional assistance."
        }
      },
      {
        "id": "e_anything_else_to_goodbye",
        "start_node_id": "n_anything_else",
        "target": {
          "type": "node",
          "node_id": "n_goodbye"
        },
        "condition": {
          "type": "llm",
          "prompt": "The caller says they do not need further help and are done."
        }
      },
      {
        "id": "e_goodbye_to_hangup",
        "start_node_id": "n_goodbye",
        "target": {
          "type": "node",
          "node_id": "n_hangup"
        },
        "condition": {
          "type": "default"
        }
      }
    ]
  },
  "tool_ids": []
}